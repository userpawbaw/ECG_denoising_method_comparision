flowchart TB
subgraph PREP[" "]
  subgraph PREP_r[" "]
    direction LR
    subgraph IN["입력 신호"]
      A1["합성 ECG"]:::data
      A2["MIT-BIH 실측 기록"]:::data
      A3["자체 장치 · AD8232"]:::data
    end
    N["잡음 7종 × 입력 SNR 7단계<br/>(-5~25 dB)"]:::noise
    FE["공통 전처리<br/>0.5~100 Hz 대역 제한<br/>전원선 notch"]:::fe
    IN --> N --> FE
  end
end
subgraph M["잡음 제거 기법 (동일 입력)"]
  subgraph M_r[" "]
    direction TB
    M1["고전 필터"]:::cls
    M2["웨이블릿<br/>임계값 처리"]:::tf
    M3["칼만 평활기"]:::mb
    M4["딥러닝"]:::dl
    UB["이상적 상한"]:::ub
  end
end
subgraph EV["평가 (동일 지표)"]
  subgraph EV_r[" "]
    direction TB
    E1["지표 4범주"]:::ev
    E2["가성 파형 생성 검증"]:::ev
  end
end
PREP --> M --> EV

